{
  "name": "@galcraft/authoring",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/recipes/index.js",
  "types": "./dist/recipes/index.d.ts",
  "exports": {
    "./recipes/operations": {
      "types": "./dist/recipes/operations.d.ts",
      "default": "./dist/recipes/operations.js"
    },
    "./recipes/official": {
      "types": "./dist/recipes/official.d.ts",
      "default": "./dist/recipes/official.js"
    },
    "./production": {
      "types": "./dist/production/index.d.ts",
      "default": "./dist/production/index.js"
    },
    "./production/draft": {
      "types": "./dist/production/draft.d.ts",
      "default": "./dist/production/draft.js"
    },
    "./production/operations": {
      "types": "./dist/production/operations.d.ts",
      "default": "./dist/production/operations.js"
    },
    "./production/preview": {
      "types": "./dist/production/preview.d.ts",
      "default": "./dist/production/preview.js"
    },
    "./recipes": {
      "types": "./dist/recipes/index.d.ts",
      "default": "./dist/recipes/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm build && vitest run recipes production"
  },
  "dependencies": {
    "@galcraft/contracts": "workspace:*",
    "@galcraft/documents": "workspace:*",
    "@galcraft/dsl": "workspace:*",
    "@galcraft/assets": "workspace:*",
    "@galcraft/templates": "workspace:*",
    "fflate": "0.8.2",
    "zod": "4.6.5",
    "@galcraft/generation-services": "workspace:*",
    "@galcraft/plugins": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.6"
  },
  "license": "MPL-2.0",
  "repository": {"type": "git", "url": "https://github.com/TianyuEric/GalCraft.git", "directory": "packages/authoring"},
  "homepage": "https://github.com/TianyuEric/GalCraft#readme"
}
