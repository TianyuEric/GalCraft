{
  "name": "@galcraft/studio",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "main": "main/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "storybook": "storybook dev -p 6007 --host 127.0.0.1 --no-open",
    "build-storybook": "storybook build -o dist-storybook",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm typecheck:host",
    "desktop:prepare": "pnpm -r --filter @galcraft/studio... --filter @galcraft/player-web --filter @galcraft/player-windows --if-present run build && node ../../tools/prepare-desktop-engine.mjs",
    "desktop:start": "electron .",
    "service": "node service/cli.mjs serve",
    "web:start": "node service/cli.mjs start",
    "desktop": "pnpm desktop:prepare && pnpm desktop:start",
    "test": "pnpm --filter @galcraft/contracts build && pnpm --filter @galcraft/documents build && pnpm --filter @galcraft/dsl build && pnpm --filter @galcraft/plugins build && vitest run",
    "typecheck:host": "tsc --noEmit -p tsconfig.main.json"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@base-ui/utils": "0.4.0",
