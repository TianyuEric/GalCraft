{
  "name": "@galcraft/player-windows",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "main/main.mjs",
  "scripts": {
    "build": "vite build && vite build --config vite.main.config.ts && vite build --config vite.compiler.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm typecheck:host",
    "desktop": "pnpm build && electron .",
    "test": "vitest run",
    "typecheck:host": "tsc --noEmit -p tsconfig.main.json"
  },
  "dependencies": {
    "@galcraft/contracts": "workspace:*",
    "@galcraft/documents": "workspace:*",
    "@galcraft/media-tools": "workspace:*",
    "@galcraft/player-ui": "workspace:*",
    "@galcraft/plugins": "workspace:*"
  },
  "devDependencies": {
    "electron": "43.7.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "@types/node": "24.13.6"
  },
  "license": "MPL-2.0",
  "repository": {"type": "git", "url": "https://github.com/TianyuEric/GalCraft.git", "directory": "apps/player-windows"},
  "homepage": "https://github.com/TianyuEric/GalCraft#readme"
}
