        "targets": [
          "web",
          "windows"
        ],
        "required": true
      },
      {
        "kind": "productionOperation",
        "key": "org.galcraft.voice-comfy/irodoriClone",
        "targets": [
          "web",
          "windows"
        ],
        "required": true
